{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/pass/[address]/activate",
      "regex": "^/api/pass/([^/]+?)/activate(?:/)?$",
      "routeKeys": {
        "nxtPaddress": "nxtPaddress"
      },
      "namedRegex": "^/api/pass/(?<nxtPaddress>[^/]+?)/activate(?:/)?$"
    },
    {
      "page": "/api/pass/[address]/key",
      "regex": "^/api/pass/([^/]+?)/key(?:/)?$",
      "routeKeys": {
        "nxtPaddress": "nxtPaddress"
      },
      "namedRegex": "^/api/pass/(?<nxtPaddress>[^/]+?)/key(?:/)?$"
    },
    {
      "page": "/api/pass/[address]/token",
      "regex": "^/api/pass/([^/]+?)/token(?:/)?$",
      "routeKeys": {
        "nxtPaddress": "nxtPaddress"
      },
      "namedRegex": "^/api/pass/(?<nxtPaddress>[^/]+?)/token(?:/)?$"
    },
    {
      "page": "/pass/[address]",
      "regex": "^/pass/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPaddress": "nxtPaddress"
      },
      "namedRegex": "^/pass/(?<nxtPaddress>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/launch",
      "regex": "^/launch(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/launch(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}