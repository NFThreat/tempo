# --- Tempo testnet (Moderato) ---
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
# Ethereum (Sepolia) for the mirror
ETH_RPC_URL=https://eth-sepolia.public.blastapi.io

# Deployed contracts (after `forge script`)
FACTORY_ADDRESS=0x...
# Comma-separated PassNFT addresses to mirror to ETH
PASS_ADDRESSES=0x...
# MirrorPassNFT on Sepolia
MIRROR_ADDRESS=0x...
# EOA on Sepolia allowed to call MirrorPassNFT.sync
MIRROR_RELAYER_PK=0x...

# Relayer server
RELAYER_PORT=3001
DB_PATH=data/state.json

# Loop tuning
RENEW_INTERVAL_MS=60000
MIRROR_INTERVAL_MS=30000
