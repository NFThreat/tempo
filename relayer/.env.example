# --- Tempo testnet (Moderato) ---
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz

# Deployed PassFactory (v4 — fixed contracts + onchain metadata)
FACTORY_ADDRESS=0x8e3f7dc5beaf73461310eddb5d05a41126bce189

# --- Relayer server (Docker sets the port; do not edit) ---
DB_PATH=/app/data/state.json

# REQUIRED: encrypts state.json at rest (AES-256-GCM). The file holds
# subscriber access-key private keys. Generate with: openssl rand -hex 32
# Losing this secret loses the keys — back it up separately from the VPS.
STATE_SECRET=openssl-rand-hex-32

# --- Public HTTPS via ngrok (free, no credit card) ---
# 1. Sign up at https://dashboard.ngrok.com (email only)
# 2. Copy your authtoken
# 3. Claim a free static domain: Universal Gateway -> Domains
NGROK_AUTHTOKEN=<from dashboard.ngrok.com>
NGROK_DOMAIN=<your-name>.ngrok-free.app

# --- Ethereum Sepolia (mirror) — optional ---
ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MIRROR_ADDRESS=0x3557fb8d1add9a041964710b375dc0211278a3a1
MIRROR_RELAYER_PK=0x...
PASS_ADDRESSES=0x17c8aDed57AF0f024265B96fb78813e660B09F73

# Loop tuning
RENEW_INTERVAL_MS=60000
MIRROR_INTERVAL_MS=30000
